---
// Case Study Page
// ------------
// Description: The case study page is a page that displays a single case study.

// Components
// - Layout
import Layout from '../../layouts/ArticleLayout.astro'

// Data
import { getCollection, render, type CollectionEntry } from 'astro:content'

export async function getStaticPaths() {
	const caseStudies = await getCollection('articles')
	return caseStudies.map((entry: CollectionEntry<'articles'>) => {
		const caseStudiesId = entry.id
		return {
			params: { id: caseStudiesId },
			props: { entry }
		}
	})
}

interface Props {
	entry: CollectionEntry<'articles'>
}

const { entry } = Astro.props as Props
const { Content } = await render(entry)
---

<Layout frontmatter={entry.data}>
	<Content />
</Layout>
