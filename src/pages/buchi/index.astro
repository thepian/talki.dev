---
import FalconScreen from '../../components/buchi/FalconScreen.astro'
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>BUCHI Falcon — Design System Showcase</title>
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <main class="stage">
      <header class="intro">
        <p class="eyebrow">Design system showcase</p>
        <h1>BUCHI Falcon — Screening · Custom workflow scenario</h1>
        <p class="lede">
          A pixel-faithful reproduction of a single screen from the BUCHI Falcon spray-dryer
          tablet UI. Built from a Figma source using the <code>design-system</code> skill,
          with a scoped <code>DESIGN.md</code> at
          <code>src/content/buchi/DESIGN.md</code> and all styles namespaced under
          <code>.buchi-falcon</code>.
        </p>
      </header>

      <div class="device-frame">
        <FalconScreen />
      </div>

      <footer class="meta">
        <small>Tokens, gaps, and rules: <code>src/content/buchi/DESIGN.md</code></small>
      </footer>
    </main>

    <style is:global>
      html, body {
        margin: 0;
        padding: 0;
        background: #fafafa;
        font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        color: #1a1a1a;
      }
      .stage {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 48px 24px 64px;
        gap: 32px;
      }
      .intro {
        max-width: 640px;
        text-align: center;
      }
      .eyebrow {
        text-transform: uppercase;
        letter-spacing: 0.12em;
        font-size: 12px;
        font-weight: 600;
        color: #6b6b6b;
        margin: 0 0 8px;
      }
      .intro h1 {
        font-size: 24px;
        margin: 0 0 12px;
        font-weight: 600;
      }
      .lede {
        margin: 0;
        font-size: 15px;
        line-height: 1.55;
        color: #4a4a4a;
      }
      .intro code, .meta code {
        background: #efefef;
        padding: 1px 6px;
        border-radius: 4px;
        font-family: ui-monospace, 'SF Mono', Menlo, monospace;
        font-size: 0.85em;
      }
      .device-frame {
        background: #1c1c1c;
        padding: 18px;
        border-radius: 36px;
        box-shadow: 0 30px 80px -20px rgba(0, 0, 0, 0.25), 0 0 0 1px rgba(0, 0, 0, 0.06);
      }
      .device-frame .buchi-falcon {
        border-radius: 18px;
      }
      .meta {
        color: #6b6b6b;
      }
    </style>
  </body>
</html>
