---
// Contact Me
// ------------
// Description: A component that displays a contact me section with a title, first column, and second column.
// Properties:
// - heading: Main heading text (optional, default: "Let's Connect")
// - body: Paragraph content as HTML string (optional)
// - email: Contact email address (optional)
// - phone: Contact phone number — displayed and used as tel: link (optional)

interface Props {
	heading?: string
	body?: string
	email?: string
	phone?: string
}

const {
	heading = "Let's Connect",
	body,
	email = 'henrik@talki.dev',
	phone = '+41 78 222 55 00',
} = Astro.props

const defaultBody = `I'm remote-friendly and always open to new opportunities. Feel free to email me at
<a class="text-neutral-800 dark:text-white" href="mailto:${email}">${email}</a>
or call me at
<a class="text-neutral-800 dark:text-white" href="tel:${phone.replace(/\s/g, '')}">${phone}</a>.`

const bodyContent = body ?? defaultBody
---

<footer id="contact" class="footer">
	<div class="footer__container">
		<div class="footer__row">
			<div class="footer__col col-span-2 row-span-2 hidden lg:block xl:row-span-1"></div>
			<div class="footer__col col-span-4 lg:col-span-10 xl:col-span-5">
				<span
					class="animate absolute -left-40 -top-52 z-[-1] size-80 rounded-full bg-primary-400 object-cover lg:-left-72 lg:-top-72 lg:size-[31.25rem] dark:bg-secondary-400"
				></span>
				<h2 class="font-noxrmal animate z-10 text-6xl not-italic lg:text-9xl" set:html={heading} />
			</div>
			<div class="footer__col col-span-4 lg:col-span-10 xl:col-span-5">
				<p class="font-headings animate text-lg leading-8 text-neutral-500" set:html={bodyContent} />
			</div>
		</div>
	</div>

	<style>
		.footer {
			@apply relative flex min-h-[800px] items-end py-12 text-neutral-600 lg:pb-40 lg:pt-60 2xl:py-40 dark:text-neutral-400;
		}
		.footer__container {
			@apply container relative z-[1] mx-auto px-6;
		}
		.footer__row {
			@apply grid grid-cols-4 justify-end gap-9 lg:grid-cols-12;
		}
		.footer__col {
			@apply relative self-end;
		}
		.footer__links {
			@apply flex flex-col gap-1 text-lg leading-8 text-neutral-600 dark:text-neutral-300 [&_a]:text-neutral-600 [&_a]:transition-colors [&_a]:duration-300 dark:[&_a]:text-neutral-300;
		}
		.footer__link {
			@apply flex items-center gap-2;
		}
	</style>
</footer>
