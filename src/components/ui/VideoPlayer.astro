---
// VideoPlayer
// ------------
// Description: renders a self-hosted video with native browser controls.
// Properties:
// - src: Path or URL to the video file (required, string)
// - poster: Path to a poster image shown before playback (optional, string)
// - controls: Show browser controls (optional, boolean, default: true)
// - autoplay: Autoplay muted (optional, boolean, default: false)
// - loop: Loop playback (optional, boolean, default: false)
// - classes: Additional classes for the wrapper (optional, string)

interface Props {
  src: string
  poster?: string
  controls?: boolean
  autoplay?: boolean
  loop?: boolean
  classes?: string
}

const {
  src,
  poster,
  controls = true,
  autoplay = false,
  loop = false,
  classes = '',
} = Astro.props
---

<div class:list={['video-player w-full', classes]}>
  <video
    src={src}
    poster={poster}
    controls={controls || undefined}
    autoplay={autoplay || undefined}
    muted={autoplay || undefined}
    loop={loop || undefined}
    playsinline
    class="w-full rounded-lg"
  ></video>
</div>
